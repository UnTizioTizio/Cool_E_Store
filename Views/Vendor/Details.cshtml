@model CoolEStore.ViewModels.VendorViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>VendorModel</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ApplicationUser.UserName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ApplicationUser.UserName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ApplicationUser!.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ApplicationUser!.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ApplicationUser!.PhoneNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ApplicationUser!.PhoneNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ApplicationUser!.Address)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ApplicationUser!.Address)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ApplicationUser!.StreetNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ApplicationUser!.StreetNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ApplicationUser!.CAP)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ApplicationUser!.CAP)
        </dd>
        @* <ul>
            @foreach(var wr in Model.WarehouseRecords!)
            {
                <li>@wr.Product.Name | @wr.Product.FinalPrice | @wr.Amount</li>
            }
        </ul> *@
    </dl>
    <hr>
    <h3 class="mt-3">Products</h3>
    <section class="product-card-container">
        @foreach(var wr in Model.WarehouseRecords!)
        {
            <a class="product-card-link" asp-controller="Product" asp-action="Details" asp-route-id="@wr.Product!.Id">
                <div class="product-card mx-3">
                    <img src="@wr.Product!.ImageUrl" class="product-card-img">
                    <div class="align-items-end mt-2">
                        <div>
                            @if(wr.Product!.Discount == 0)
                            {
                                <span class="fs-4 fw-bold">
                                    @Html.DisplayFor(modelItem => wr.Product!.BasePrice)
                                </span> 
                            }
                            else
                            {
                                <span class="fs-4 fw-bold">
                                    @Html.DisplayFor(modelItem => wr.Product!.FinalPrice)
                                </span>
                                <span class="fw-light text-decoration-line-through">
                                    @Html.DisplayFor(modelItem => wr.Product!.BasePrice)
                                </span>
                                <span class="fw-bold text-danger">
                                    (@Html.DisplayFor(modelItem => wr.Product!.Discount))
                                </span>
                            }
                        </div>
                        <div class="fs-5">@wr.Product!.Name</div>
                        <div class="align-items-end">
                            <div class="fs-6 mt-1">@wr.Product!.Vendor!.ApplicationUser!.UserName</div>
                            @* <div>@wr.Product!.AvgReviews/5 (@wr.Product!.NumReviews)</div> *@
                        </div>
                    </div>
                </div>
            </a>
        }
    </section>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
