@model IEnumerable<CoolEStore.ViewModels.VendorViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Vendors</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationUserViewModel.UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationUserViewModel.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationUserViewModel.PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationUserViewModel.Address)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) 
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ApplicationUserViewModel.UserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ApplicationUserViewModel.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ApplicationUserViewModel.PhoneNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ApplicationUserViewModel.Address),
                @Html.DisplayFor(modelItem => item.ApplicationUserViewModel.StreetNumber) -
                @Html.DisplayFor(modelItem => item.ApplicationUserViewModel.CAP)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
