@using CoolEStore.ViewModels
@model IEnumerable<IGrouping<ProductCategory, ProductViewModel>>

@{
    ViewData["Title"] = "Homepage";
}

<h1>Homepage</h1>
@foreach(IGrouping<ProductCategory, ProductViewModel> group in Model)
{
    <hr>
    <h3 class="mt-3">@group.Key</h3>
    <section class="product-card-container">
        @foreach(var product in group)
        {
            <partial name="_ProductCard" model="@product"/>
        }
    </section>
}